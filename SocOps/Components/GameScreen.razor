@using SocOps.Models

<div class="cosmic-shell flex flex-col min-h-full">
    <header class="cosmic-topbar flex items-center justify-between">
        <button @onclick="OnReset" class="cosmic-ghost-btn text-sm">
            ← Back
        </button>
        <h1 class="cosmic-game-title">Soc Ops</h1>
        <div class="w-16"></div>
    </header>

    <p class="cosmic-instruction py-2 px-4">
        Mark each square as you find matching people around the room.
    </p>

    @if (HasBingo)
    {
        <div class="cosmic-banner">
            BINGO locked. Stellar line completed.
        </div>
    }

    <div class="flex-1 flex items-center justify-center p-3">
        <div class="cosmic-board-wrap w-full max-w-md mx-auto">
            <BingoBoard
                Board="@Board"
                WinningSquareIds="@WinningSquareIds"
                OnSquareClick="@OnSquareClick" />
        </div>
    </div>
</div>

@code {
    [Parameter]
    public List<BingoSquareData> Board { get; set; } = new();

    [Parameter]
    public HashSet<int> WinningSquareIds { get; set; } = new();

    [Parameter]
    public bool HasBingo { get; set; }

    [Parameter]
    public EventCallback<int> OnSquareClick { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }
}
