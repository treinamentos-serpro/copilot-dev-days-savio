<div class="cosmic-shell flex flex-col items-center justify-center min-h-full p-6">
    <section class="cosmic-start-hero text-center w-full">
        <p class="cosmic-kicker">Nebula Session</p>
        <h1 class="cosmic-title">Soc Ops</h1>
        <p class="cosmic-subtitle">Social Bingo, now in orbit.</p>

        <div class="cosmic-panel text-left">
            <h2>Mission Brief</h2>
            <ul class="cosmic-list">
                <li>Find people who match each prompt.</li>
                <li>Tap a square every time you find a match.</li>
                <li>Complete 5 in a row to secure BINGO.</li>
            </ul>
        </div>

        <button @onclick="OnStart" class="cosmic-cta text-lg">
            Launch Game
        </button>
    </section>
</div>

@code {
    [Parameter]
    public EventCallback OnStart { get; set; }
}
