<div class="fixed inset-0 cosmic-overlay flex items-center justify-center p-4 z-50">
    <div class="cosmic-modal">
        <div class="cosmic-modal-icon">✦</div>
        <h2 class="cosmic-modal-title">BINGO</h2>
        <p class="cosmic-modal-text">Line completed. Keep exploring the room.</p>

        <button @onclick="OnDismiss" class="cosmic-cta-secondary">
            Keep Playing
        </button>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnDismiss { get; set; }
}
